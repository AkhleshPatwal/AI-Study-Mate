rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStudyPack(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.ownerId == userId &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserStats(data) {
      return data.packsCreated is number &&
             data.quizzesCompleted is number &&
             (!('caseStudiesAttempted' in data) || data.caseStudiesAttempted is number) &&
             (!('caseStudiesCompleted' in data) || data.caseStudiesCompleted is number) &&
             (!('podcastsCreated' in data) || data.podcastsCreated is number) &&
             (!('podcastsCompleted' in data) || data.podcastsCompleted is number);
    }

    function isValidCaseStudy(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.topic is string && data.topic.size() <= 300 &&
             data.ownerId == userId &&
             data.status in ['not_started', 'in_progress', 'completed'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidPodcast(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.topic is string && data.topic.size() <= 300 &&
             data.ownerId == userId &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Connection Probe Document
    match /test/connection {
      allow get: if true;
    }

    // User Study Packs
    match /users/{userId}/studyPacks/{packId} {
      allow get: if isOwner(userId) && isValidId(packId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(packId) && isValidStudyPack(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(packId) && isValidStudyPack(incoming(), userId) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(userId) && isValidId(packId);
    }

    // User Case Studies
    match /users/{userId}/caseStudies/{caseId} {
      allow get: if isOwner(userId) && isValidId(caseId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(caseId) && isValidCaseStudy(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(caseId) && isValidCaseStudy(incoming(), userId) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(userId) && isValidId(caseId);
    }

    // User Podcasts
    match /users/{userId}/podcasts/{podcastId} {
      allow get: if isOwner(userId) && isValidId(podcastId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(podcastId) && isValidPodcast(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(podcastId) && isValidPodcast(incoming(), userId) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(userId) && isValidId(podcastId);
    }

    // User Learning Statistics
    match /users/{userId}/stats/overview {
      allow get: if isOwner(userId);
      allow write: if isOwner(userId) && isValidUserStats(incoming());
    }
  }
}
